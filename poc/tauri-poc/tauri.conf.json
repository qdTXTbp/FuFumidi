{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-poc",
  "version": "0.1.0",
  "identifier": "com.fufumidi.tauripoc",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FuFumidi Tauri POC",
        "width": 900,
        "height": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}