# https://editorconfig.org —— 让编辑器与 CI 对同一份文件得出同一套空白/编码结论。
# 只声明仓库里已经成立的事实；改这一节等于改全仓库的约定，先读 docs/FOUNDATION.md。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# 仓库里这些文件目前是 CRLF（含 600 行的 main.js 与全部 workflow），
# 声明成事实而不是理想值；核对方式见 docs/HYGIENE.md 的「行尾与编码」一节。
[*.{js,cjs,mjs,ts,vue,json,yml,yaml,py,md,html,css,toml,rs}]
end_of_line = crlf

[*.py]
indent_size = 4

[*.{rs,toml}]
indent_size = 4

# PowerShell：文件必须是 UTF-8 with BOM，否则 Windows PowerShell 5.1 按 ANSI 解码，
# 中文注释变乱码并直接报语法错（本机实测，见根 AGENTS.md 与 _attic/README.md）。
[*.{ps1,psm1,psd1}]
charset = utf-8-bom
end_of_line = crlf
indent_size = 4

[*.{bat,cmd}]
end_of_line = crlf

# NSIS 脚本由 makensis 解析（build/nsis-custom.nsh），保持 CRLF
[*.{nsh,nsi}]
end_of_line = crlf

[Makefile]
indent_style = tab
