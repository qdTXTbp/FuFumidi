{
    "compilerOptions":  {
                            "target":  "ES2020",
                            "module":  "ESNext",
                            "moduleResolution":  "Bundler",
                            "lib":  [
                                        "ES2020",
                                        "DOM",
                                        "DOM.Iterable"
                                    ],
                            "strict":  true,
                            "noUncheckedIndexedAccess": true,
                            "noEmit":  true,
                            "allowJs":  true,
                            "checkJs":  false,
                            "esModuleInterop":  true,
                            "skipLibCheck":  true,
                            "resolveJsonModule":  true,
                            "isolatedModules":  true,
                            "verbatimModuleSyntax":  false,
                            "types":  [
                                          "vite/client"
                                      ]
                        },
    "include":  [
                    "src/**/*.ts",
                    "src/**/*.js",
                    "src/**/*.vue",
                    "src/**/*.d.ts"
                ]
}
