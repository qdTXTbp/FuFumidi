{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FuFumidi",
  "version": "6.5.0-beta.1",
  "identifier": "com.fufumidi.desktop",
  "build": {
    "frontendDist": "../../renderer/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FuFumidi",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "bundle/python/": "python/",
      "bundle/engine/": "engine/",
      "bundle/soundfonts/": "soundfonts/",
      "bundle/models/": "models/",
      "bundle/elevate.exe": "elevate.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
