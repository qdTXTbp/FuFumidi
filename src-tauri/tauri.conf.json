{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FuFumidi",
  "version": "3.1.13",
  "identifier": "com.fufumidi.app",
  "build": {
    "beforeDevCommand": "npm --prefix frontend run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix frontend run build",
    "frontendDist": "../renderer/dist"
  },
  "app": {
    "windows": [
      {
        "title": "FuFumidi",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ],
    "shortDescription": "离线 MIDI 播放 / 编辑 / 转录 / 乐谱工作站",
    "longDescription": "FuFumidi - offline MIDI workstation"
  }
}
