{
  "name": "fufumidi",
  "productName": "FuFumidi",
  "version": "6.5.0-beta.1",
  "description": "离线 MIDI 播放 / 编辑 / 可视化 / 分析 / 乐谱 / 转录（音频转 MIDI）一体工具",
  "main": "main.js",
  "author": {
    "name": "FuFumidi",
    "email": "dev@fufumidi.local"
  },
  "license": "MIT",
  "homepage": "https://github.com/qdTXTbp/FuFumidi",
  "repository": {
    "type": "git",
    "url": "https://github.com/qdTXTbp/FuFumidi.git"
  },
  "private": true,
  "scripts": {
    "build:ui": "npm --prefix frontend run build",
    "build:rust": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-rust.ps1",
    "test:rust": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-rust.ps1",
    "pack:source": "node build.js source",
    "pack:full": "node build.js full",
    "pack:base": "node build.js base",
    "dist:win": "set NODE_OPTIONS=--use-system-ca&& node scripts/build-updater.js && electron-builder --win nsis --x64",
    "typecheck": "npm --prefix frontend run typecheck",
    "audit:params": "node scripts/audit-param-contract.cjs --strict",
    "audit:dead-options": "node scripts/audit-dead-options.cjs",
    "audit:job-params": "node scripts/audit-job-params.cjs",
    "audit": "npm run check:version && npm run check:i18n && npm run check:licenses && npm run audit:params && npm run audit:job-params && npm run audit:dead-options && npm run audit:ui-tokens && npm run check:contracts && npm run check:brand && npm run tauri:handler-audit",
    "audit:ui-tokens": "node scripts/check-ui-tokens.mjs",
    "contracts:write": "node scripts/contracts/extract-ipc.mjs --write && node scripts/contracts/extract-engine-params.mjs --write",
    "brand:update": "node scripts/brand/check-brand-assets.mjs --update",
    "check:brand": "node scripts/brand/check-brand-assets.mjs",
    "build:rust-core": "cargo build --manifest-path crates/Cargo.toml --release",
    "test:rust-core": "cargo test --manifest-path crates/Cargo.toml",
    "check:contracts": "node scripts/contracts/extract-ipc.mjs --check && node scripts/contracts/extract-engine-params.mjs --check",
    "dualrun:midi": "node scripts/dualrun/compare-midi.mjs --gen",
    "test:ui": "node --test \"frontend/tests/*.test.js\"",
    "test:e2e": "npm run build:ui && node scripts/e2e/run.mjs",
    "test": "npm run test:rust && npm run test:ui && npm run test:plugin && npm run test:separate && npm run test:download && npm run test:autosave && npm run test:export && npm run test:taskcenter && npm run test:quality && npm run test:storage && npm run test:storage-cache && npm run test:db && npm run test:probe && npm run test:rust-bridge && npm run test:zip && npm run test:update-sign && npm run test:update-util && npm run test:platform && npm run test:dataroot && npm run test:plugin-host && npm run test:dawproject && npm run check:version && npm run test:usermeta && npm run test:speedtest && npm run test:feedback && npm run test:netlify && npm run test:worker",
    "test:worker": "npm --prefix cloud-sync/worker run test:worker",
    "test:plugin": "node --test scripts/test-plugin-sandbox.mjs",
    "test:download": "node --test scripts/test-fast-download.mjs",
    "test:autosave": "node --test scripts/test-autosave.mjs",
    "test:export": "node --test scripts/test-export.mjs",
    "test:taskcenter": "node --test scripts/test-taskcenter.mjs",
    "test:quality": "node scripts/eval-quality.mjs",
    "test:storage": "node --test scripts/test-paths-storage.mjs",
    "test:storage-cache": "node --test scripts/test-storage-cache.mjs",
    "test:db": "node --test scripts/test-db-persist.mjs",
    "test:probe": "node --test scripts/test-engine-probe-cache.mjs",
    "test:rust-bridge": "node --test scripts/test-rust-bridge.mjs",
    "test:update-sign": "node --test scripts/test-update-sign.mjs",
    "test:omr": "node scripts/test-engine-omr.mjs",
    "test:platform": "node --test scripts/test-platform.mjs",
    "test:dataroot": "node --test scripts/test-data-root-pick.mjs scripts/test-data-root-io.mjs",
    "test:plugin-host": "node --test scripts/test-plugin-host.mjs",
    "test:update-util": "node --test scripts/test-update-util.mjs",
    "test:dawproject": "node scripts/validate-dawproject.mjs",
    "i18n:apply": "node scripts/i18n-apply-batch.mjs",
    "build:platform": "node scripts/build-platform.mjs",
    "sign:update": "node scripts/sign-update.mjs",
    "audio:rtl": "node scripts/audio-rtl.mjs",
    "perf:baseline": "node scripts/perf-baseline.mjs --update-baseline",
    "perf:gate": "node scripts/perf-baseline.mjs",
    "check:version": "node scripts/check-version-consistency.mjs",
    "check:i18n": "node scripts/check-i18n-coverage.mjs",
    "check:empty-catch": "node scripts/check-empty-catch.cjs",
    "check:licenses": "node scripts/gen-licenses.mjs",
    "licenses:write": "node scripts/gen-licenses.mjs --write",
    "test:feedback": "node --test scripts/test-feedback.mjs",
    "test:netlify": "node netlify/lib/feedback-core.test.mjs",
    "test:separate": "node --test scripts/test-separate-common.mjs",
    "test:usermeta": "node --test scripts/test-usermeta.mjs",
    "test:speedtest": "node --test scripts/test-update-speedtest.mjs",
    "test:cancel": "node --test scripts/test-cancel-worker.mjs",
    "push:api": "node scripts/api-push.mjs",
    "test:zip": "node --test scripts/test-zip-safe.mjs",
    "design:shoot": "node scripts/design/shoot.mjs",
    "tauri:smoke": "node scripts/tauri/smoke.mjs",
    "tauri:build": "npm run build:ui && cargo build --manifest-path shells/tauri/Cargo.toml",
    "tauri:release": "npm run build:ui && cd shells/tauri && tauri build --no-bundle",
    "tauri:bundle": "npm run build:ui && npm run tauri:stage && cd shells/tauri && tauri build",
    "tauri:stage": "node scripts/tauri/stage-bundle.mjs",
    "tauri:coverage": "node scripts/tauri/ipc-coverage.mjs",
    "tauri:call-audit": "node scripts/tauri/bridge-call-audit.mjs",
    "tauri:arg-audit": "node scripts/tauri/arg-audit.mjs",
    "tauri:handler-audit": "node scripts/tauri/handler-audit.mjs",
    "tauri:sf-registry": "node scripts/tauri/gen-soundfont-registry.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "sql.js": "^1.14.2",
    "webwallgl": "^3.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3"
  }
}
